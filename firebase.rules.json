{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$session": {
        "meta": {
          ".read": "auth != null && auth.token.sessionCode == $session"
        },
        "broadcast": {
          ".read": "auth != null && auth.token.sessionCode == $session"
        },
        "groups": {
          ".read": "auth != null && auth.token.role == 'teacher' && auth.token.sessionCode == $session",
          "$team": {
            ".read": "auth != null && auth.token.sessionCode == $session && (auth.token.role == 'teacher' || (auth.token.role == 'student' && auth.token.teamId == $team))"
          }
        }
      }
    },
    "privateSessions": { ".read": false, ".write": false },
    "privateTeams": { ".read": false, ".write": false }
  }
}
