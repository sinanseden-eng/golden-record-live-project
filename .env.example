# Public Firebase web configuration (safe to expose to the browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.REGION.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=

# Firebase Admin service-account fields (server-only: never commit real values)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# A private teacher setup password required to create sessions
CLASS_ADMIN_KEY=replace-with-a-long-random-teacher-key
